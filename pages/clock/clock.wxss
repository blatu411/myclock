.container {
  width: 100%;
  height: 100%;
  background-color: #000;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.clock {
  font-size: 32vmin;
  color: #fff;
  font-weight: bold;
  font-family: 'Courier New', monospace;
  letter-spacing: 0.05em;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}
